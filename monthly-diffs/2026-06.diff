+noncomputable def quotientMap (q : GaugeGroupQuot) : GaugeGroupI →* GaugeGroup q :=
+  match q with
+  | .ℤ₆ => GaugeGroupℤ₆.mk
+  | .ℤ₂ => GaugeGroupℤ₂.mk
+  | .ℤ₃ => GaugeGroupℤ₃.mk
+  | .I => MonoidHom.id GaugeGroupI
