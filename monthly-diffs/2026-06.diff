-  change _ = (μ F' X Y).hom.hom
-    ((repNatTransOfColorApp η X).hom (PiTensorProduct.tprod k p) ⊗ₜ[k]
-    (repNatTransOfColorApp η Y).hom (PiTensorProduct.tprod k q))
-  rw [repNatTransOfColorApp_tprod, repNatTransOfColorApp_tprod]
-  erw [μ_tmul_tprod]
-  apply congrArg
-  funext i
-  match i with
-  | Sum.inr i => rfl
-  | Sum.inl i => rfl
