+
+/-- The central subgroup of `GaugeGroupI` quotiented by a gauge-group quotient choice. -/
+noncomputable def subgroup : GaugeGroupQuot → Subgroup GaugeGroupI
+  | .ℤ₆ => gaugeGroupℤ₆SubGroup
+  | .ℤ₂ => gaugeGroupℤ₂SubGroup
