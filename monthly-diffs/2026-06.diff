+  · obtain ⟨i, rfl⟩ := ComponentIdx.single.symm.surjective b
+    conv_rhs => enter [2, i]; rw [evalT_basis_single]
+    simp
+  · simp
+  · conv_lhs => rw [h]
+    simp [Finset.smul_sum, smul_smul]
+  · simp [add_smul, Finset.sum_add_distrib]
+    grind
