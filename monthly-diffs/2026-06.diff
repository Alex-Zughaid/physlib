-  m.iso.inv_hom_id
-
-/-- The inverse of a morphism in `OverColor C`. -/
-abbrev _root_.CategoryTheory.CoreHom.symm (m : f ⟶ g) : g ⟶ f := ⟨m.iso.symm⟩
