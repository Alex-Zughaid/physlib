    {d : ℕ} (μ : Fin 1 ⊕ Fin d) (f : SpaceTime d → M) (y : SpaceTime d) :
    deriv μ f y = manifoldDeriv 𝓘(ℝ, M) μ f y := by
  rw [deriv_eq_mfderiv, manifoldDeriv_eq]

