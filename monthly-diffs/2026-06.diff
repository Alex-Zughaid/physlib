-    Rep.tensor_ρ, Rep.Hom.hom, ConcreteCategory.hom, CategoryStruct.comp,
-    Representation.IntertwiningMap.comp_toLinearMap, LinearMap.coe_comp,
-    Representation.IntertwiningMap.coe_toLinearMap, Function.comp_apply]
-  erw [μ_tmul_tprod]
