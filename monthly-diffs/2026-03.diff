+      ∘L SchwartzMap.evalCLM ℝ (Space d) ℝ (basis i)
+      ∘L SchwartzMap.fderivCLM ℝ (Space d) ℝ
+
+lemma gradSchwartz_apply_eq_grad {d} (η : 𝓢(Space d, ℝ)) (x : Space d):
+    gradSchwartz η x = grad η x := by
+  simp [gradSchwartz, grad_eq_sum]
+  rfl
+
