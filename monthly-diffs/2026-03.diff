-open scoped Matrix
-
-section
-variable (d : Type*) [Fintype d]
-
-/-- Experimental Euclidean-space Ket: a unit vector in `EuclideanSpace ℂ d`. -/
-structure KetEuc where
-  vec : EuclideanSpace ℂ d
-  normalized' : ‖vec‖ = 1
-end
-
-namespace NewBraket
