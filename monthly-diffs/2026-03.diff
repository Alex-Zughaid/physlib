+-- At α = 1, B(α) = ρ.M since (1-1)/(2·1) = 0 and conj by 1 is identity.
+private lemma B_of_one (ρ σ : MState d) : B_of ρ σ 1 = ρ.M := by
+  simp [B_of, HermitianMat.rpow_zero, HermitianMat.conj_one]
