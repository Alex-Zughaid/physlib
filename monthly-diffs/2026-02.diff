-  · congr 1
-    ext1
-    unfold ρABR;
-    ext
-    simp [MState.traceLeft, MState.traceRight]
-    unfold perm_C_ABR perm_B_ACR
-    simp [HermitianMat.traceLeft, HermitianMat.traceRight]
