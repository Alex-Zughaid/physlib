+  rw [ h_rhs ];
+  have h_rhs : (diagonal 𝕜 (fun (i : m × n) => Real.log (d₁ i.1) + Real.log (d₂ i.2))) =
+    (diagonal 𝕜 (fun (i : m × n) => Real.log (d₁ i.1))) + (diagonal 𝕜 (fun (i : m × n) => Real.log (d₂ i.2))) := by
+      simp +decide [ diagonal ]
