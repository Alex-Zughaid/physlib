+      · refine' ContinuousOn.comp ( show ContinuousOn ( fun m : HermitianMat n 𝕜 => m⁻¹ ) ( { m : HermitianMat n 𝕜 | m.toMat.PosDef } ) from _ ) _ _;
+        · intro m hm;
