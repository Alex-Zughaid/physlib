-  right_inv := by intro x; simp
-
-private def perm_C_ABR : (dA × dB × dC) × (dA × dB × dC) ≃ dC × (dA × dB × (dA × dB × dC)) where
-  toFun x := let ((a,b,c), r) := x; (c, (a,b,r))
-  invFun x := let (c, (a,b,r)) := x; ((a,b,c), r)
-  left_inv := by intro x; simp
-  right_inv := by intro x; simp
