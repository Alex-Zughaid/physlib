-/-- The state on systems A, B, and R, obtained by purifying ρ and tracing out C. -/
-private def ρABR (ρ : MState (dA × dB × dC)) : MState (dA × dB × (dA × dB × dC)) :=
-  ((MState.pure ρ.purify).relabel perm_C_ABR.symm).traceLeft
