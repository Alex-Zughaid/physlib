+  have h_integral_limit : ∫ t in (0)..T, (1 + t)⁻¹ • 1 - (x + t • 1)⁻¹ ≤ ∫ t in (0)..T, (1 + t)⁻¹ • 1 - (y + t • 1)⁻¹ := by
