-    ((MState.pure ρ.purify).relabel perm_C_ABR.symm).traceRight = ρ.traceLeft.traceLeft := by
-  have := MState.purify_spec ρ;
-  convert traceRight_relabel_perm_C_ABR _ using 1;
-  rw [ this ]
