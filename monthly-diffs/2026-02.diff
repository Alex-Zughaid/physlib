+    (x : HermitianMat n 𝕜) (hx : x.toMat.PosDef) (t : ℝ) (ht : 0 ≤ t) :
+    ((1 + t)⁻¹ • (1 : HermitianMat n 𝕜) - (x + t • 1)⁻¹) = cfc x (fun u => (1 + t)⁻¹ - (u + t)⁻¹) := by
+  have h_cfc_sub : (1 + t)⁻¹ • 1 = cfc x (fun u => (1 + t)⁻¹) ∧ x + t • 1 = cfc x (fun u => u + t) ∧ (x + t • 1)⁻¹ = cfc x (fun u => (u + t)⁻¹) := by
