+    (a • x + b • y + t • 1)⁻¹ ≤ a • (x + t • 1)⁻¹ + b • (y + t • 1)⁻¹ := by
+  have hx' : (x + t • 1).toMat.PosDef := hx.add_posSemidef (.smul .one ht)
+  have hy' : (y + t • 1).toMat.PosDef := hy.add_posSemidef (.smul .one ht)
+  convert inv_convex hx' hy' ha hb hab using 1
