+    rw [ Finset.sum_comm ] at this
+    simp_all only [← mul_assoc, ← Finset.sum_mul, zero_mul, Finset.sum_const_zero] ;
+    rw [ eq_comm ] at this
+    simp_all only [mul_assoc] ;
+    rw [ ← Finset.sum_congr rfl fun _ _ => by rw [ mul_left_comm ] ] at this
