-private def perm_AC_BR : (dA × dB × dC) × (dA × dB × dC) ≃ (dA × dC) × (dB × (dA × dB × dC)) where
-  toFun x := let ((a,b,c), r) := x; ((a,c), (b,r))
-  invFun x := let ((a,c), (b,r)) := x; ((a,b,c), r)
