-private def perm_B_ACR : (dA × dB × dC) × (dA × dB × dC) ≃ dB × (dA × dC × (dA × dB × dC)) where
-  toFun x := let ((a,b,c), r) := x; (b, (a,c,r))
-  invFun x := let (b, (a,c,r)) := x; ((a,b,c), r)
