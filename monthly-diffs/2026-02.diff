+  -- By `HermitianMat.ker_sum`, the kernel of the sum is the intersection of the kernels of the terms.
+  have h_ker_sum : (∑ k, ρ.M.conj (pinching_kraus σ k).toMat).ker = ⨅ k, (ρ.M.conj (pinching_kraus σ k).toMat).ker := by
