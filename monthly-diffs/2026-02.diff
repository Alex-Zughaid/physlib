+/-- Relabeling a pure state by a bijection yields another pure state. -/
+theorem relabel_pure_exists (ψ : Ket d₁) (e : d₂ ≃ d₁) :
+    ∃ ψ' : Ket d₂, (pure ψ).relabel e = pure ψ' := by
+  refine ⟨⟨fun i => ψ (e i), ?_⟩, rfl⟩
+  rw [← ψ.normalized', Fintype.sum_equiv e]
+  congr!
+
