+      use B.conjTranspose;
+      convert hB using 1;
+      simp [ Matrix.star_eq_conjTranspose ];
+    exact ⟨ fun i => Classical.choose ( h_decomp i ), fun i => Classical.choose_spec ( h_decomp i ) ⟩;
