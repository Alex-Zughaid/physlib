def preContrMetric (d : ℕ := 3) : 𝟙_ (Rep ℝ (LorentzGroup d)) ⟶ Contr d ⊗ Contr d := Rep.ofHom
  {
    toFun := fun a => a • (preContrMetricVal d),
    map_add' := fun x y => by
