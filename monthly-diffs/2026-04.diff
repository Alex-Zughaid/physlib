          • ((complexContrBasis i)) ⊗ₜ[ℂ] leftRightToMatrix.symm ((pauliBasis i)) := by
            refine Finset.sum_congr rfl (fun i _ => ?_)
            refine Finset.sum_eq_single i (fun b _ hb => ?_) (fun hb => ?_)
