-        | inAsymp : (Σ f, 𝓕.AsymptoticLabel f) × (Fin 3 → ℝ) → 𝓕.FieldOp
-        | position : (Σ f, 𝓕.PositionLabel f) × SpaceTime → 𝓕.FieldOp
-        | outAsymp : (Σ f, 𝓕.AsymptoticLabel f) × (Fin 3 → ℝ) → 𝓕.FieldOp
-    declNo: "2.5"
