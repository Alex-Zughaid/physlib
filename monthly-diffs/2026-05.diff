+  have hleft_combo :
+      (1 - θ) • leftMulHS (ℋ := ℋ) A₁ + θ • leftMulHS (ℋ := ℋ) A₂ =
+        leftMulHS (ℋ := ℋ) ((1 - θ) • A₁ + θ • A₂) := by
+    ext T
+    show ((1 - θ) • (A₁ * toOp T) + θ • (A₂ * toOp T) : L ℋ) =
+      ((1 - θ) • A₁ + θ • A₂) * toOp T
