+  rcases Fin.eq_self_or_eq_succAbove i j with rfl | ⟨j, rfl⟩
+  · simp_all
+  rw [succSuccAbove_eq_succAbove_succAbove, Set.range_comp, Fin.range_succAbove]
+  ext a
+  simp only [Set.mem_compl_iff, Set.mem_singleton_iff, Set.mem_image]
+  apply Iff.intro
