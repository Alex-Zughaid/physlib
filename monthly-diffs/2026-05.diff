        _ = (1 : ℝ) • (R1 * (A * R1)) := by rw [hhalf]
        _ = R1 * A * R1 := by simp [mul_assoc]
  have hmid_conv :
      cfcR (ℋ := HSum ℋ) f
          ((1 / 2 : ℝ) • ((star U : L (HSum ℋ)) * Atilde * (U : L (HSum ℋ))) +
            (1 / 2 : ℝ) • ((star V : L (HSum ℋ)) * Atilde * (V : L (HSum ℋ)))) ≤
        ((1 / 2 : ℝ) • cfcR f ((star U : L (HSum ℋ)) * Atilde * (U : L (HSum ℋ))) +
