    (Matrix.stdBasis R ((i:ι) → dO i) ((i:ι) → dO i))
    (Matrix.reindex (Equiv.arrowProdEquivProdArrow _ dO dO)
      (Equiv.arrowProdEquivProdArrow _ dI dI)
      (LinearMap.toMatrix
        (_root_.Basis.piTensorProduct (fun i ↦ Matrix.stdBasis R (dI i) (dI i)))
