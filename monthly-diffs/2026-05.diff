+  have h_support :
+      (σ.M ^ γ).mat * (σ.M ^ (-γ)).mat = σ.M.supportProj.mat ∧
+      (σ.M ^ (-γ)).mat * (σ.M ^ γ).mat = σ.M.supportProj.mat :=
