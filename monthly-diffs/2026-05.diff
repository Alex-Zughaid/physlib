+@[fun_prop]
+lemma contDiff_action {d} (Λ : LorentzGroup d) (A : ElectromagneticPotential d)
+    (hA : ContDiff ℝ n A) : ContDiff ℝ n (fun x => Λ • A (Λ⁻¹ • x)) := by
