    rw [hB1_block, hB2_block]
    rw [blockOp_smulR, blockOp_smulR, blockOp_add, blockDiagonal_eq_blockOp]
    congr 1
    · have hhalf : (2⁻¹ + 2⁻¹ : ℝ) = (1 : ℝ) := by norm_num
      calc
        (1 / 2 : ℝ) • (star X * A * X) + (1 / 2 : ℝ) • (star X * A * X)
            = (2⁻¹ + 2⁻¹ : ℝ) • (star X * (A * X)) := by
                simp [add_smul, mul_assoc]
