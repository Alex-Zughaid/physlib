+      ((div_le_one (by linarith [ht.1])).2 (by linarith [ht.1]))
+      (Real.rpow_nonneg ht.1.le _)
+
+private lemma tendsto_intervalIntegral_weighted_div_nonneg {x p : ℝ}
+    (hx : 0 ≤ x) (hp : 0 < p) (hp1 : p < 1) :
+    Filter.Tendsto
+      (fun T => ∫ t in (0)..T, t ^ (p - 1) * (x / (x + t)))
