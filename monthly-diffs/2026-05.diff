+
+lemma succSuccAbove_symm (i j : Fin (n + 1 + 1)) :
+    succSuccAbove i j = succSuccAbove j i := by
+  ext m
+  simp only [succSuccAbove_val]
+  grind (splits := 5)
+
+@[simp, nolint simpVarHead]
