private lemma leftMulHS_rankOne (A : L ℋ) (x y : ℋ) :
    leftMulHS (ℋ := ℋ) A (ofOp (InnerProductSpace.rankOne ℂ x y)) =
      ofOp (InnerProductSpace.rankOne ℂ (A x) y) := by
