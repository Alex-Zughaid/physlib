+@[fun_prop]
+lemma differentiable_deriv {d} {A : ElectromagneticPotential d}
+    (hA : ContDiff ℝ 2 A) (μ ν : Fin 1 ⊕ Fin d) :
+    Differentiable ℝ (fun x => ∂_ μ A x ν) := by
+  have diff_partial (μ) :
