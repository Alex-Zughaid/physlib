    intro x hx
    exact ne_of_gt (As hx)
  have hB_ne0 : ∀ x ∈ spectrum ℝ B, f x ≠ 0 := by
    intro x hx
    exact ne_of_gt (Bs hx)
  let uA : (𝓐)ˣ :=
    cfcUnits (R := ℝ) (A := 𝓐) (p := IsSelfAdjoint) f A hA_ne0 (ha := hA_sa)
  let uB : (𝓐)ˣ :=
