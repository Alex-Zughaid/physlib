+      (by
+        intro x hx
+        have hx0 : 0 < x := by simpa [Set.Ioi] using hB₂_spec hx
+        exact hx0.le)
+      (by
+        intro x hx
+        have hx0 : 0 < x := by simpa [Set.Ioi] using hB₁_spec hx
+        exact hx0.le)
+  have hpow :
+      B₁ ^ (1 - s) ≤ B₂ ^ (1 - s) := by
+    simpa [cfcR, LownerHeinzCore.cfcR,
+      CFC.rpow_eq_cfc_real (A := L ℋ) (a := B₁) (y := 1 - s) (ha := hB₁0),
+      CFC.rpow_eq_cfc_real (A := L ℋ) (a := B₂) (y := 1 - s) (ha := hB₂0)] using hcfc
