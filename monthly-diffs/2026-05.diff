+        _ = B ^ p := by rw [hβmul]
+    simp [liebTraceMap, liebExtensionTraceMap, hpow, mul_assoc]
+  simpa [hpow_rewrite hB₁_mem, hpow_rewrite hB₂_mem, hpow_rewrite hB_combo_mem] using
+    (le_trans hconc hmono)
