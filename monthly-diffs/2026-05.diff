+    (hA : ContDiff ℝ ∞ A) (μ ν : Fin 1 ⊕ Fin d) :
+    Differentiable ℝ (fun x => ∂_ μ A x ν) := by
+  apply differentiable_deriv (hA.of_le (ENat.LEInfty.out)) μ ν
