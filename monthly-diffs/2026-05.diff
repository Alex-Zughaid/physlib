    intro i
    let C : (Time × Space) × ℝ → EuclideanSpace ℝ (Fin 3) := fun p =>
      let (t, x) := p.1
      let u := p.2
      (u • basis.repr x) ⨯ₑ₃ B t (u • x)
    change ContDiff ℝ n (fun x => C x i)
    fin_cases i
    all_goals
    · simp [C, crossProduct]
      fun_prop
  suffices h : ContDiff ℝ n ↿A by
    convert h
    simp [ofElectromagneticField_vectorPotential, A]
  fun_prop

