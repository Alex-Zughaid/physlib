        _ = star X * (A * X) := by simp
        _ = star X * A * X := by simp [mul_assoc]
    · simp [mul_assoc]
    · simp [mul_assoc]
    · have hhalf : (2⁻¹ + 2⁻¹ : ℝ) = (1 : ℝ) := by norm_num
      calc
        (1 / 2 : ℝ) • (-Complex.I • R1 * A * (Complex.I • R1)) +
            (1 / 2 : ℝ) • (Complex.I • R1 * A * (-Complex.I • R1))
            = (2⁻¹ + 2⁻¹ : ℝ) • (R1 * (A * R1)) := by
