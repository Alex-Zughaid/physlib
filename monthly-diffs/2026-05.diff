+  have hconc :=
+    liebTrace_jointlyConcaveOn_pdSet (ℋ := ℋ) (s := q) hq hq1 K
+      (A₁ := A₁) (A₂ := A₂) (B₁ := B₁ ^ β) (B₂ := B₂ ^ β)
+      (θ := θ) hA₁ hA₂ hB₁β hB₂β hθ0 hθ1
+  have hpow_rewrite :
+      ∀ {A B : L ℋ}, B ∈ pdSet (ℋ := ℋ) →
