+private lemma hSqrt_mul_hInvSqrt_eq_one
+    {h : ℝ → ℝ} {B : L ℋ}
+    (hB : IsSelfAdjoint B) (Bs : spectrum ℝ B ⊆ Set.Ioi (0 : ℝ))
+    (hcont : ContinuousOn h (Set.Ioi (0 : ℝ)))
+    (hpos : ∀ x ∈ Set.Ioi (0 : ℝ), 0 < h x) :
+    hSqrt (ℋ := ℋ) h B * hInvSqrt (ℋ := ℋ) h B = (1 : L ℋ) := by
