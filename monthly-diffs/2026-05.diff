+@[expose] public section
+
+noncomputable section
+
+variable {d : Type*}
+variable [Fintype d] [DecidableEq d]
+variable {𝕜 : Type*} [RCLike 𝕜]
+
+open HermitianMat
+open scoped InnerProductSpace RealInnerProductSpace Topology
