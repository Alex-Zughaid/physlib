+    exact liebTraceMap_mono_right (ℋ := ℋ) (s := q) hsmono K
+      ((1 - θ) • A₁ + θ • A₂)
+      ((1 - θ) • (B₁ ^ β) + θ • (B₂ ^ β))
+      (((1 - θ) • B₁ + θ • B₂) ^ β)
