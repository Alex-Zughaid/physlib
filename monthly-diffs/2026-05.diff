lemma boostGenerator_transpose (i : Fin 3) :
    (boostGenerator i)ᵀ = boostGenerator i := by
  ext μ ν
  rcases μ with μ | μ <;> rcases ν with ν | ν <;>
    fin_cases μ <;> fin_cases ν <;> simp [boostGenerator]

