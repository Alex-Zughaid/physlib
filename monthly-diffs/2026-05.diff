    (𝓜 f).IsClosable := by
  refine isClosable_of_exists_dense_formalAdjoint ?_ ?_
  · exact mulOperator_hasDenseDomain hf
  · refine ⟨𝓜 (conj ∘ f), ?_, ?_⟩
    · exact mulOperator_hasDenseDomain (by measurability)
    · rw [← mulOperator_adjoint_eq_conj hf]
