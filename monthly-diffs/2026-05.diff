### C.1. Self-adjoint
-/

lemma mulOperator_isSelfAdjoint_ofReal
    {f : Space d → ℂ} (hf : AEStronglyMeasurable f) (hf' : conj ∘ f = f) :
    IsSelfAdjoint (𝓜 f) := by
  apply isSelfAdjoint_def.mpr
  rw [mulOperator_adjoint_eq_conj hf, hf']

/-!
## D. Closable & unbounded
-/

