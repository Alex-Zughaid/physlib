          = ∫ t in (0)..T, ∑ i, t ^ (p - 1) * (A.H.eigenvalues i / (A.H.eigenvalues i + t)) := by
              apply intervalIntegral.integral_congr_ae
              filter_upwards with t ht
              rw [trace_mul_inv_shift_eq_sum_div hA (by
                have htIoc : t ∈ Set.Ioc (0 : ℝ) T := by
