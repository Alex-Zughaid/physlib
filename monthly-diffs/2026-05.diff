    have hR0sq_nonneg : (0 : L ℋ) ≤ R0 * R0 := by
      simpa [hR0self.star_eq] using star_mul_self_nonneg R0
    have hneg : (0 : L ℋ) ≤ (- (f 0)) • (R0 * R0) := by
      exact smul_nonneg (by linarith [hf0]) hR0sq_nonneg
