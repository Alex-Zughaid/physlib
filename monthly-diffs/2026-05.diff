    cfcR (ℋ := ℋ) g A * cfcR (ℋ := ℋ) k A = cfcR (ℋ := ℋ) m A := by
  rw [← cfc_mul (R := ℝ) (A := L ℋ) (p := IsSelfAdjoint)
      (f := g) (g := k) (a := A) hg hk]
  apply cfc_congr
  intro x hx
  simpa using hmul x hx

