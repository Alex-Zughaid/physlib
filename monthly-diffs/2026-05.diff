  have hsum :
      (Matrix.fromBlocks (1 : Matrix B B ℂ) (M X) ((M X)ᴴ) (M (Xᴴ * X))).PosSemidef := by
    convert hblock.add hgap_block using 1
    ext i j
    cases i <;> cases j <;>
      simp [Matrix.fromBlocks, sub_eq_add_neg, add_left_comm, add_comm]
