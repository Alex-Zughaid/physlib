  simpa [sub_nonneg] using
    (Matrix.PosDef.fromBlocks₁₁ (B := M X) (D := M (Xᴴ * X))
      (hA := (Matrix.PosDef.one : (1 : Matrix B B ℂ).PosDef))).mp hsum

