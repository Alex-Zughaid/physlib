  have huA_val : (uA : 𝓐) = A := by
    simp [uA, cfcUnits, f, cfc_id' (R := ℝ) (a := A) (ha := hA_sa)]
  have huB_val : (uB : 𝓐) = B := by
    simp [uB, cfcUnits, f, cfc_id' (R := ℝ) (a := B) (ha := hB_sa)]
